{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["resource", "operations"],
  "properties": {
    "resource": {
      "type": "string",
      "description": "The resource this capability applies to"
    },
    "operations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of permitted operations"
    }
  },
  "additionalProperties": false
}
