{
  "realm": "mint-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,

  "roles": {
    "realm": [
      {
        "name": "default-roles-mint-demo",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access"],
          "client": {}
        },
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "token-minter",
        "description": "Grants access to the /mint/token endpoint",
        "composite": false,
        "clientRole": false
      }
    ],
    "client": {}
  },

  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles information to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "web-origins",
      "description": "OpenID Connect scope for web origins",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "offline_access",
      "description": "OpenID Connect built-in scope: offline_access",
      "protocol": "openid-connect",
      "attributes": {
        "consent.screen.text": "${offlineAccessScopeConsentText}",
        "display.on.consent.screen": "true",
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "mint:capability",
      "description": "Permission to mint capability tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false",
        "schema-uri": "http://schema-server/schemas/capability.json",
        "max-ttl-seconds": "3600",
        "allowed-audiences": "test-service",
        "schema-content-type": "application/json"
      }
    }
  ],

  "defaultDefaultClientScopes": ["roles", "profile", "email", "web-origins", "openid"],
  "defaultOptionalClientScopes": ["offline_access", "address", "phone"],

  "clients": [
    {
      "clientId": "account",
      "name": "${client_account}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/mint-demo/account/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "defaultRoles": ["view-profile", "manage-account"],
      "redirectUris": ["/realms/mint-demo/account/*"],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    },
    {
      "clientId": "mint-client",
      "name": "Mint Client",
      "description": "Service account client for token minting demos",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "mint-client-secret",
      "surrogateAuthRequired": false,
      "alwaysDisplayInConsole": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "bearerOnly": false,
      "consentRequired": false,
      "defaultClientScopes": ["roles", "profile", "email", "web-origins"],
      "optionalClientScopes": ["offline_access", "mint:capability"]
    }
  ],

  "users": [
    {
      "username": "service-account-mint-client",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "mint-client",
      "credentials": [],
      "realmRoles": ["token-minter", "default-roles-mint-demo"],
      "clientRoles": {},
      "groups": []
    }
  ]
}
